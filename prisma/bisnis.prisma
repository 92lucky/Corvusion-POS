model Business {
  id       String       @id @default(cuid())
  name     String
  type     BusinessType
  phone    String?
  email    String?
  address  String?
  city     String?
  province String?
  logo     String?

  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  categories     Category[]
  customers      Customer[]
  products       Product[]
  purchases      Purchase[]
  sales          Sale[]
  suppliers      Supplier[]
  units          Unit[]
  users          User[]
  trialStartedAt DateTime?
  trialEndsAt    DateTime?

  subscription Subscription?

  subscriptionPayments SubscriptionPayment[]
}
